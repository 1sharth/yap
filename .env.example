# Optional fallback cloud transcription backends
# Note: Yap runs 100% locally on your NVIDIA GPU (Faster-Whisper) by default.
# Only populate these if you want cloud fallbacks when GPU is unavailable.
DEEPGRAM_API_KEY=
GROQ_API_KEY=

# Optional custom directory / file overrides
# DICTATE_THINKING_FILE=/path/to/thinking.txt
# DICTATE_RECORDINGS_DIR=/path/to/recordings
# YAP_DB_PATH=/path/to/yap.db
